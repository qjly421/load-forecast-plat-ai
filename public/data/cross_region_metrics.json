{
  "methodology": {
    "data": "Fraunhofer Energy-Charts v2/public_power 真实负荷 (data/eua_{de,be,nl}.csv)",
    "window": "2024-01-01 ~ 2025-06-30 (UTC 15min 网格, 96点/天; 本地日历用真实DST)",
    "ramp_definition": "|P(t+1h)-P(t)| >= threshold, 窗口1h",
    "threshold_note": "相对阈值 = 3.88% 各区域观测峰值(与DE原3000MW一致); 使爬坡稀有度跨区域可比(各约20%)",
    "feature_sets": {
      "CORE_37": "load+时相+负荷滞后/滚动/动量+气象(单点Open-Meteo)",
      "RENEW_7": "净负荷+风光出力(无容量列故无利用率/wind_on/off)",
      "F44": "CORE_37 + RENEW_7, 三国统一可得(Energy-Charts给全了BE风光)",
      "caveats": [
        "气象为单点(DE=Berlin, NL=Amsterdam, BE=Brussels), 未做全网加权",
        "EU 无装机容量列 -> 无 solar_util/wind_util, data/eua 仅供风光出力",
        "BE 本轮首次拿到完整风光(旧OPSD无BE风光列), 故零样本统一用F44",
        "UTC 连续网格建特征, 本地日历经zoneinfo取真实DST, 规避DT切换导致的非96点日"
      ]
    }
  },
