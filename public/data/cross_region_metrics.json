{
  "methodology": {
    "data": "OPSD time_series_15min_singleindex.csv (DE/BE/NL 实际负荷) + 山东全网负荷 shandong_full_merged.csv (全网(MW), Beijing local)",
    "window": "欧: 2018-01-01~2019-12-31 (各70080点); 山东SD: 2025-01-01~2026-07-15 (15min, 52872有效点, ~554天)",
    "ramp_definition": "|P(t+1h)-P(t)| >= threshold, 窗口1h",
    "threshold_note": "相对阈值 = 3.88% 各区域观测峰值(与DE原3000MW一致); DE=3000MW, BE=534MW, NL=735MW, SD=5033MW; 使爬坡稀有度跨区域可比 (但见 caveats: SD 实际正类占比仅10.8%)",
    "feature_sets": {
      "CORE_37": "load+时相+负荷滞后/滚动/动量+气象",
      "F48": "CORE+净负荷+风光出力+容量利用率(仅DE)",
      "F46": "CORE+净负荷+风光出力(去容量利用率, DE/NL可得)",
      "caveats": [
        "NL 光伏出力约21%缺测(55296/70080), 以0填充(夜间/未上报视为0); 净负荷在缺测期被高估",
        "BE 无风电/光伏/容量列, 仅能用 load+time+weather(无净负荷/新能源特征)",
        "气象为单点(DE=Berlin, NL=Amsterdam, BE=Brussels), 未做全网加权",
        "各区域时间轴统一为本地CET/CEST(DST规则一致)",
        "山东SD 无气象/温度列, 无新能源/净负荷可用; 仅能用 load+time+幅值 核心28特征 (特征数少于欧区46-48)",
        "SD「临时光伏」仅6.5%可测(集中在2026/6-7), 缺失过多, 未入模型",
        "SD 数据含约4处~24h断点与约3个整日缺失(288点), 清洗=仅对<=6h小洞线性插值, 大洞保留NaN经dropna剔除",
        "SD 在3.88%峰值阈值下正类占比仅10.8% (欧区20-22%): 山东为特大型稳定电网(129.7GW), 相对1h摆动更平缓, 稀有度等同前提不严格成立",
        "SD 时间轴为北京本地时间(无DST); 跨区迁移假定日内时相可按时钟位迁移"
      ],
      "SD_CORE_28": "load+时相(8)+负荷滞后(7)+负荷滚动std/mean(6)+负荷范围/峰谷(4)+负荷动量(2), 共28列; 山东无气象/新能源列, 不可用 RENEW 与气象 → 比 DE(48)/NL(46) 特征更少"
    }
  },
